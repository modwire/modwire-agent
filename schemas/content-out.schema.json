{
  "$defs": {
    "ContentMetadata": {
      "$id": "https://raw.githubusercontent.com/modwire/modwire-agent/main/schemas/content-metadata.schema.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Supported provenance, accessibility, and presentation metadata.",
      "properties": {
        "accepted_on": {
          "default": "",
          "description": "Owner acceptance date in ISO 8601 calendar-date form when applicable.",
          "pattern": "^$|^\\d{4}-\\d{2}-\\d{2}$",
          "title": "Accepted On",
          "type": "string"
        },
        "alt": {
          "default": "",
          "description": "Accessible alternative text for image content.",
          "title": "Alt",
          "type": "string"
        },
        "format": {
          "default": "",
          "description": "Source-specific content format when one is known.",
          "title": "Format",
          "type": "string"
        },
        "source": {
          "default": "",
          "description": "Name of the system that supplied the block.",
          "title": "Source",
          "type": "string"
        },
        "source_url": {
          "default": "",
          "description": "Canonical URL from which the block was collected.",
          "title": "Source Url",
          "type": "string"
        },
        "title": {
          "default": "",
          "description": "Optional image title or caption.",
          "title": "Title",
          "type": "string"
        }
      },
      "title": "ContentMetadata",
      "type": "object"
    },
    "ContentRole": {
      "enum": [
        "heading",
        "subheading",
        "paragraph",
        "list",
        "markdown",
        "snippet",
        "image"
      ],
      "title": "ContentRole",
      "type": "string"
    },
    "RecordSlug": {
      "maxLength": 180,
      "minLength": 3,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*$",
      "type": "string"
    }
  },
  "$id": "https://raw.githubusercontent.com/modwire/modwire-agent/main/schemas/content-out.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "properties": {
          "content": {
            "type": "string"
          }
        }
      },
      "if": {
        "properties": {
          "role": {
            "const": "list"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "description": "Plain list item strings without presentation markers.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        }
      }
    }
  ],
  "properties": {
    "content": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      ],
      "description": "An array of plain strings for lists; a string for every other role.",
      "examples": [
        [
          "First item",
          "Second item"
        ]
      ],
      "title": "Content"
    },
    "id": {
      "title": "Id",
      "type": "integer"
    },
    "language": {
      "description": "Natural language for prose and lists; syntax identifier for snippets.",
      "minLength": 1,
      "title": "Language",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/ContentMetadata",
      "description": "Typed provenance, accessibility, and presentation metadata."
    },
    "position": {
      "title": "Position",
      "type": "integer"
    },
    "record_slug": {
      "$ref": "#/$defs/RecordSlug"
    },
    "role": {
      "$ref": "#/$defs/ContentRole",
      "description": "Selects the content shape and rendering semantics."
    }
  },
  "required": [
    "role",
    "content",
    "language",
    "id",
    "record_slug",
    "position"
  ],
  "title": "ContentOut",
  "type": "object"
}

# Compose reuses these credentials and overrides only the container-side
# address to postgres:5432. Host development continues through localhost:5433.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/modwire_records
SECRET_KEY=replace-with-a-local-secret

SCAFFOLDING_API_PORT=8100
RECORDS_EMBEDDINGS_ENABLED=1
RECORDS_EMBEDDING_PROVIDER=deterministic
